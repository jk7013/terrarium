# Terrarium 환경 설정

# 모드 설정
OFFLINE_MODE=true
# ONLINE: 외부 LLM/임베딩 API 사용
# OFFLINE: 로컬 모델만 사용

# 서버 설정
API_HOST=0.0.0.0
API_PORT=9000

# LLM 설정
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen-local-7b

# 임베딩 설정
EMBEDDING_MODEL=BAAI/bge-m3-ko

# 리랭커 설정
RERANKER_MODEL=dragonkue/bge-reranker-v2-m3-ko

# 데이터 저장소
DATA_DIR=./data
CORPUS_DB_PATH=./data/corpus.db
VECTOR_STORE_PATH=./data/vectors

# 로깅
LOG_LEVEL=INFO
LOG_FORMAT=json


