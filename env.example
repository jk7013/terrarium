# Terrarium 환경 설정

# 모드 설정
OFFLINE_MODE=true
# ONLINE: 외부 LLM/임베딩 API 사용
# OFFLINE: 로컬 모델만 사용

# 서버 설정
API_HOST=0.0.0.0
API_PORT=9000

# LLM 설정
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=bge-m3

# PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=terrarium
DB_USER=terrarium
DB_PASSWORD=terrarium
DATABASE_URL=postgresql://terrarium:terrarium@localhost:5432/terrarium
POSTGRES_DB=terrarium
POSTGRES_USER=terrarium
POSTGRES_PASSWORD=terrarium
POSTGRES_PORT=5432

# RAG
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=6000
INDEX_INPUT_PATH=data/documents/corpus.jsonl

# 임베딩 설정
EMBEDDING_MODEL=BAAI/bge-m3-ko

# 리랭커 설정
RERANKER_MODEL=dragonkue/bge-reranker-v2-m3-ko

# 데이터 저장소
DATA_DIR=./data
CORPUS_DB_PATH=./data/corpus.db
VECTOR_STORE_PATH=./data/vectors

# 로깅
LOG_LEVEL=INFO
LOG_FORMAT=json


