# Terrarium local development settings.
# Copy this file to .env and fill secrets locally. Never commit .env.

TERRARIUM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9000,http://127.0.0.1:9000

# Database. If DATABASE_URL is set, it takes precedence over DB_*.
DB_HOST=terrarium-pgvector
DB_PORT=5432
DB_NAME=terrarium
DB_USER=terrarium
DB_PASSWORD=change-me
# DATABASE_URL=postgresql://terrarium:change-me@terrarium-pgvector:5432/terrarium

# LLM / embedding runtime
OFFLINE_MODE=true
DEFAULT_MODEL=qwen3:4b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=bge-m3

# OpenAI is optional. Use only when OFFLINE_MODE=false.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Retrieval
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=6000
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
DEBUG_LOG_PATH=

